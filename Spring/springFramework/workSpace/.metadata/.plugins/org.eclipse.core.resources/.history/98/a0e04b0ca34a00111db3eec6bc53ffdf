package kosta.advice;

import org.aspectj.lang.ProceedingJoinPoint;

public class TimerAdvice {
	/**
	 * 공통기능(부가기능)
	 * : around방식(사전처리, 사후처리)
	 * : 기능
	 * 		사전의 현재시간을 구한다.
	 * 		사후에 현재시간 구해서 사후 - 사전. 핵심기능을 실행한 실행시간을 측정
	 * 		
	 * 		@param : ProceedingJoinPoint(사전, 사후일 때 다음 target 대상을 호출할 수 있는 메소드를 제공한다) 
	 * 				  JoinPoint(target의 메소드에 대한 정보를 조회할 수 있는 메소드 제공)라는 객체를 상속받은 객체
	 * 
	 * 		@return : Object는 target 대상이 리턴한 값을 리턴해준다.
	 */
	public Object around(ProceedingJoinPoint joinPoint) {
		// 사전처리
		String methodName = joinPoint.getSignature().getName();
		System.out.println("[LOG] " + methodName + "호출되기 전입니다.");
		Object obj = joinPoint.proceed(); // 다음 advice or target method를 호출한다.
		
		// 사후처리
		
		return obj;
	}
}
