package kosta.advice;

import java.io.BufferedWriter;
import java.io.File;
import java.io.FileWriter;
import java.io.IOException;

import org.aspectj.lang.ProceedingJoinPoint;
import org.springframework.util.StopWatch;

public class AroundAdvice {
	
	private BufferedWriter bw;
	
	public AroundAdvice() {
		File output = new File("src/main/java/kosta/advice/log.txt");
		try {
			bw = new BufferedWriter(new FileWriter(output, true));
		} catch (IOException e) {
			e.printStackTrace();
		}
	}
	
	public void around(ProceedingJoinPoint jp) throws Throwable {
		StopWatch sw = new StopWatch();
		sw.start();
		
		Object obj = jp.proceed();
		
		sw.stop();
		
		System.out.print(jp.getSignature().getName() + " 호출");
		System.out.print(" / 인수 개수 : " + jp.getArgs().length);
		System.out.print(" / 리턴값 : " + obj);
		System.out.println(" / 총 실행 시간 : " + sw.getLastTaskTimeMillis() + "ms");
		
		bw.write(jp.getSignature().getName() + " 호출");
		bw.write(" / 인수 개수 : " + jp.getArgs().length);
		bw.write(" / 리턴값 : " + obj);
		bw.write(" / 총 실행 시간 : " + sw.getLastTaskTimeMillis() + "ms");
		bw.newLine();
		
		bw.flush();
	}
}
