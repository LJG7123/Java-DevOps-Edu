package kosta.advice;

import java.io.BufferedWriter;
import java.io.File;
import java.io.FileWriter;
import java.io.IOException;

import javax.annotation.PostConstruct;
import javax.annotation.PreDestroy;

import org.aspectj.lang.ProceedingJoinPoint;
import org.aspectj.lang.annotation.Around;
import org.aspectj.lang.annotation.Aspect;
import org.springframework.stereotype.Component;
import org.springframework.util.StopWatch;

@Aspect
@Component
public class AroundAdvice {
	
	private BufferedWriter bw;
	
	@Around("execution(* kosta.test.*Impl.*(..))")
	public AroundAdvice() {
		File output = new File("src/main/java/kosta/advice/log.txt");
		try {
			bw = new BufferedWriter(new FileWriter(output, true));
		} catch (IOException e) {
			e.printStackTrace();
		}
	}
	
	@PostConstruct
	public void onCreate() {
		System.out.println("AroundAdvice created");
	}
	
	@PreDestroy
	public void onDestroy() {
		try {
			if (bw != null) bw.close();
			System.out.println("BufferedWriter closed");
		} catch (IOException e) {
			e.printStackTrace();
		}
	}
	
	public void around(ProceedingJoinPoint jp) throws Throwable {
		StopWatch sw = new StopWatch();
		sw.start();
		
		Object obj = jp.proceed();
		
		sw.stop();
		
		System.out.print(jp.getSignature().getName() + " 호출");
		System.out.print(" / 인수 개수 : " + jp.getArgs().length);
		System.out.print(" / 리턴값 : " + obj);
		System.out.println(" / 총 실행 시간 : " + sw.getLastTaskTimeMillis() + "ms");
		
		bw.write(jp.getSignature().getName() + " 호출");
		bw.write(" / 인수 개수 : " + jp.getArgs().length);
		bw.write(" / 리턴값 : " + obj);
		bw.write(" / 총 실행 시간 : " + sw.getLastTaskTimeMillis() + "ms\n");
		bw.newLine();
		
		bw.flush();
	}
}
